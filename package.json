{
  "name": "equipa",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @equipa/api --filter @equipa/web dev",
    "build": "pnpm -r --filter @equipa/api --filter @equipa/web build",
    "db:generate": "pnpm --filter @equipa/api prisma:generate",
    "db:migrate": "pnpm --filter @equipa/api prisma:migrate",
    "db:seed": "pnpm --filter @equipa/api prisma:seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
