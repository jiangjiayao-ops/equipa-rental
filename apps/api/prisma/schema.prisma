generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMMERCIAL
  OPERATIONS
  FINANCE
  MAINTENANCE
  READ_ONLY
}

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  ON_RENT
  IN_TRANSIT
  MAINTENANCE
  QUARANTINE
  SOLD
  RETIRED
}

enum BillingPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

/// When rent is invoiced relative to each rental period.
/// ADVANCE (default): bill at period start — common for equipment rentals.
/// ARREARS: bill at period end.
enum BillingTiming {
  ADVANCE
  ARREARS
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProposalSendChannel {
  EMAIL
  WHATSAPP
}

enum ProposalSendStatus {
  QUEUED
  SENT
  FAILED
  DEV_OUTBOX
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  WRITTEN_OFF
}

enum PaymentMethod {
  PIX
  BOLETO
}

enum FiscalDocType {
  NFS_E
  NF_E
}

enum FiscalDocStatus {
  DRAFT
  SUBMITTED
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum MobilizationType {
  TO_SITE
  FROM_SITE
}

enum MobilizationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderStatus {
  SCHEDULED
  OPEN
  DONE
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  /// Legal / razão social
  name      String
  tradeName String?
  cnpj      String   @unique
  ie        String?  /// Inscrição Estadual
  im        String?  /// Inscrição Municipal
  street    String?
  city      String?
  state     String?
  cep       String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  users     User[]
}

model Branch {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  /// Display / site name (e.g. pátio)
  name           String
  legalName      String?
  tradeName      String?
  cnpj           String?
  ie             String?
  im             String?
  street         String?
  city           String
  state          String
  cep            String?
  phone          String?
  email          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  equipment      Equipment[]
  proposals      Proposal[]
  contracts      Contract[]
  calendarBlocks CalendarBlock[]
  mobilizations  MobilizationOrder[]
  transfersFrom  BranchTransfer[] @relation("TransferFrom")
  transfersTo    BranchTransfer[] @relation("TransferTo")

  @@unique([organizationId, code])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  passwordHash   String
  name           String
  phone          String?
  /// WhatsApp number (digits with country code preferred, e.g. 5511987654321)
  whatsapp       String?
  role           Role         @default(READ_ONLY)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ownedProposals Proposal[]   @relation("ProposalOwner")
}

model Customer {
  id           String            @id @default(cuid())
  legalName    String
  tradeName    String?
  document     String            @unique
  documentType String            @default("CNPJ")
  email        String?
  phone        String?
  city         String?
  state        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  contacts     CustomerContact[]
  sites        CustomerSite[]
  proposals    Proposal[]
  contracts    Contract[]
  invoices     Invoice[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  email      String?
  phone      String?
  role       String?
}

model CustomerSite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  address    String
  city       String
  state      String
}

model EquipmentCategory {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  nameEn      String?
  equipment   Equipment[]
  rateCards   RateCard[]
}

model Equipment {
  id              String            @id @default(cuid())
  code            String            @unique
  categoryId      String
  category        EquipmentCategory @relation(fields: [categoryId], references: [id])
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id])
  /// Make / fabricante
  brand           String
  model           String
  year            Int?
  serialNumber    String?
  /// Vehicle identification number (when applicable)
  vin             String?
  /// Chassis / frame number
  frameNumber     String?
  plate           String?
  hourMeter       Float             @default(0)
  status          EquipmentStatus   @default(AVAILABLE)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  proposalLines   ProposalLine[]
  contractLines   ContractLine[]
  calendarBlocks  CalendarBlock[]
  mobilizations   MobilizationOrder[]
  workOrders      WorkOrder[]
  meterReadings   MeterReading[]
  transfers       BranchTransfer[]
}

model MeterReading {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  hours       Float
  recordedAt  DateTime  @default(now())
  source      String    @default("manual")
}

model RateCard {
  id         String            @id @default(cuid())
  categoryId String
  category   EquipmentCategory @relation(fields: [categoryId], references: [id])
  name       String
  weeklyRate Float
  monthlyRate Float
  yearlyRate Float
  active     Boolean           @default(true)
}

model Proposal {
  id               String                 @id @default(cuid())
  number           String                 @unique
  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id])
  branchId         String
  branch           Branch                 @relation(fields: [branchId], references: [id])
  /// Commercial owner shown as contact on proposal / PDF / public page.
  ownerId          String?
  owner            User?                  @relation("ProposalOwner", fields: [ownerId], references: [id])
  status           ProposalStatus         @default(DRAFT)
  /// Copied to Contract on accept/convert. Default ADVANCE.
  billingTiming    BillingTiming          @default(ADVANCE)
  /// Allowed machine hours for the rental. Ignored when hoursUnlimited=true.
  allowedHours     Float                  @default(200)
  hoursUnlimited   Boolean                @default(false)
  validUntil       DateTime?
  notes            String?
  /// Opaque token for public client acceptance page (/p/:token).
  publicToken      String?                @unique
  acceptedOptionId String?
  acceptedOption   ProposalOption?        @relation("AcceptedOption", fields: [acceptedOptionId], references: [id])
  sentAt           DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  lines            ProposalLine[]
  options          ProposalOption[]       @relation("ProposalOptions")
  sendAttempts     ProposalSendAttempt[]
  contracts        Contract[]
}

model ProposalLine {
  id            String        @id @default(cuid())
  proposalId    String
  proposal      Proposal      @relation(fields: [proposalId], references: [id])
  equipmentId   String?
  equipment     Equipment?    @relation(fields: [equipmentId], references: [id])
  description   String
  /// Legacy/default period on the line; option.billingPeriod wins on accept.
  billingPeriod BillingPeriod
  unitRate      Float         @default(0)
  quantity      Int           @default(1)
  mobFee        Float         @default(0)
  demobFee      Float         @default(0)
}

/// Period package the client can choose (e.g. 7 days, 30 days, monthly).
model ProposalOption {
  id            String        @id @default(cuid())
  proposalId    String
  proposal      Proposal      @relation("ProposalOptions", fields: [proposalId], references: [id], onDelete: Cascade)
  label         String
  billingPeriod BillingPeriod
  durationDays  Int
  unitRate      Float
  mobFee        Float         @default(0)
  demobFee      Float         @default(0)
  sortOrder     Int           @default(0)
  selected      Boolean       @default(false)
  acceptedBy    Proposal[]    @relation("AcceptedOption")
}

model ProposalSendAttempt {
  id          String              @id @default(cuid())
  proposalId  String
  proposal    Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  channel     ProposalSendChannel
  status      ProposalSendStatus
  toAddress   String?
  provider    String
  providerRef String?
  error       String?
  publicUrl   String?
  payloadJson String?
  createdAt   DateTime            @default(now())
}

model Contract {
  id            String           @id @default(cuid())
  number        String           @unique
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  proposalId    String?
  proposal      Proposal?        @relation(fields: [proposalId], references: [id])
  status        ContractStatus   @default(DRAFT)
  billingPeriod BillingPeriod
  /// ADVANCE (default): invoice at period start. ARREARS: invoice at period end.
  billingTiming BillingTiming    @default(ADVANCE)
  allowedHours  Float            @default(200)
  hoursUnlimited Boolean         @default(false)
  startDate     DateTime
  endDate       DateTime
  depositAmount Float            @default(0)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lines         ContractLine[]
  amendments    ContractAmendment[]
  invoices      Invoice[]
  mobilizations MobilizationOrder[]
  calendarBlocks CalendarBlock[]
}

model ContractLine {
  id            String        @id @default(cuid())
  contractId    String
  contract      Contract      @relation(fields: [contractId], references: [id])
  equipmentId   String
  equipment     Equipment     @relation(fields: [equipmentId], references: [id])
  description   String
  billingPeriod BillingPeriod
  unitRate      Float
  mobFee        Float         @default(0)
  demobFee      Float         @default(0)
}

model ContractAmendment {
  id          String         @id @default(cuid())
  contractId  String
  contract    Contract       @relation(fields: [contractId], references: [id])
  type        String
  notes       String?
  fromPeriod  BillingPeriod?
  toPeriod    BillingPeriod?
  createdAt   DateTime       @default(now())
}

model CalendarBlock {
  id          String   @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  startDate   DateTime
  endDate     DateTime
  reason      String
}

model MobilizationOrder {
  id          String             @id @default(cuid())
  contractId  String
  contract    Contract           @relation(fields: [contractId], references: [id])
  equipmentId String
  equipment   Equipment          @relation(fields: [equipmentId], references: [id])
  branchId    String
  branch      Branch             @relation(fields: [branchId], references: [id])
  type        MobilizationType
  status      MobilizationStatus @default(SCHEDULED)
  scheduledAt DateTime
  completedAt DateTime?
  carrier     String?
  cost        Float              @default(0)
  siteAddress String?
}

model BranchTransfer {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  fromBranchId String
  fromBranch  Branch    @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId  String
  toBranch    Branch    @relation("TransferTo", fields: [toBranchId], references: [id])
  status      String    @default("COMPLETED")
  transferredAt DateTime @default(now())
  notes       String?
}

model Invoice {
  id          String          @id @default(cuid())
  number      String          @unique
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  contractId  String?
  contract    Contract?       @relation(fields: [contractId], references: [id])
  status      InvoiceStatus   @default(DRAFT)
  issueDate   DateTime        @default(now())
  dueDate     DateTime
  /// Snapshot of contract billing timing at generation time.
  billingTiming BillingTiming?
  /// Rental period covered by this invoice (set from contract billing timing).
  periodStart DateTime?
  periodEnd   DateTime?
  totalAmount Float
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       InvoiceLine[]
  payments    Payment[]
  fiscalDocs  FiscalDocument[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Float   @default(1)
  unitAmount  Float
  totalAmount Float
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  method    PaymentMethod
  amount    Float
  paidAt    DateTime
  externalRef String?
  notes     String?
  createdAt DateTime      @default(now())
}

model FiscalDocument {
  id           String          @id @default(cuid())
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id])
  type         FiscalDocType   @default(NFS_E)
  status       FiscalDocStatus @default(DRAFT)
  provider     String          @default("mock")
  providerRef  String?
  accessKey    String?
  authorizedAt DateTime?
  payloadJson  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model MaintenancePlan {
  id             String   @id @default(cuid())
  name           String
  equipmentCode  String?
  everyHours     Float?
  everyDays      Int?
  active         Boolean  @default(true)
  workOrders     WorkOrder[]
}

model WorkOrder {
  id          String          @id @default(cuid())
  planId      String?
  plan        MaintenancePlan? @relation(fields: [planId], references: [id])
  equipmentId String
  equipment   Equipment       @relation(fields: [equipmentId], references: [id])
  title       String
  status      WorkOrderStatus @default(SCHEDULED)
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
}
